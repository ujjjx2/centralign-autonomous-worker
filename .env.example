# Inference uses the locally installed Gemma 4 E2B model through Ollama.
MODEL_BACKEND=gemma
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_TIMEOUT=45
# Explicit rules-only mode for CI or diagnosing Ollama outages:
# MODEL_BACKEND=rules

EXECUTION_MODE=browser
BROWSER_EXECUTABLE=
HEADLESS=true
DATABASE_PATH=./data/company.sqlite3
ARTIFACTS_DIR=./data/artifacts
APP_HOST=127.0.0.1
APP_PORT=8000
APPROVAL_THRESHOLD_CENTS=100000
